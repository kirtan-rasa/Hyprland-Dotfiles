[global]
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 150)
    origin = top-right
    offset = (15, 10)
    transparency = 12
    corner_radius = 16
    frame_width = 2
    frame_color = "#b4befe"
    separator_color = "#45475a"
    separator_height = 1
    padding = 10
    horizontal_padding = 14
    gap_size = 8
    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    stack_duplicates = false
    icon_position = left
    min_icon_size = 24
    max_icon_size = 32
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6e3a1"
    frame_color = "#a6e3a1"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#b4befe"
    timeout = 6

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 4
