configuration {
    show-icons: false;
    disable-history: true;
}

* {
    bg-col:      rgba(24, 24, 28, 0.85);
    bg-col-alt:  rgba(35, 35, 40, 0.9);
    fg-col:      #E0E0E0;
    accent-col:  #89B4FA;
    border-col:  rgba(255, 255, 255, 0.08);
}

window {
    transparency: "real";
    background-color: @bg-col;
    border: 1px;
    border-color: @border-col;
    border-radius: 15px;
    width: 280px;
    location: center;
    anchor: center;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [ "listview" ];
}

listview {
    background-color: transparent;
    lines: 5;
    columns: 1;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    layout: vertical;
}

element {
    background-color: transparent;
    text-color: @fg-col;
    orientation: horizontal;
    border-radius: 10px;
    padding: 12px 16px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg-col;
}

element selected.normal {
    background-color: @accent-col;
    text-color: #1E1E2E;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 13";
}

entry {
    enabled: false;
}

scrollbar {
    enabled: false;
}
