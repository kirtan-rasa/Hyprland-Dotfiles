/* Rofi drun (app launcher) — Catppuccin Mocha, в стиле остальных меню */

configuration {
    show-icons: true;
    icon-theme: "Papirus";
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    base:       rgba(24, 24, 37, 0.94);
    surface0:   rgba(49, 50, 68, 0.9);
    surface1:   rgba(69, 71, 90, 0.95);
    text:       #cdd6f4;
    subtext0:   #a6adc8;
    subtext1:   #bac2de;
    lavender:   #b4befe;
    mauve:      #cba6f7;
    border-col: rgba(180, 190, 254, 0.18);
}

window {
    transparency: "real";
    background-color: @base;
    border: 1px;
    border-color: @border-col;
    border-radius: 20px;
    width: 640px;
    location: center;
    anchor: center;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ "inputbar", "listview" ];
    spacing: 14px;
}

inputbar {
    background-color: @surface0;
    border-radius: 14px;
    padding: 12px 16px;
    children: [ "prompt", "entry" ];
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @mauve;
    font: "JetBrainsMono Nerd Font Bold 13";
}

entry {
    background-color: transparent;
    text-color: @text;
    placeholder: "Search apps…";
    font: "JetBrainsMono Nerd Font 13";
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 6px;
    cycle: true;
    dynamic: true;
    layout: vertical;
    fixed-height: false;
}

element {
    background-color: transparent;
    orientation: horizontal;
    border-radius: 14px;
    padding: 8px 12px;
    spacing: 12px;
    border: 2px;
    border-color: transparent;
}

element normal.normal {
    text-color: @subtext1;
}

element selected.normal {
    background-color: @surface1;
    text-color: @text;
    border-color: @mauve;
}

element alternate.normal {
    text-color: @subtext1;
}

element-icon {
    background-color: transparent;
    size: 28px;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
}

scrollbar {
    background-color: transparent;
}

scrollbar slider {
    background-color: rgba(180, 190, 254, 0.35);
    border-radius: 8px;
    min-width: 6px;
}
